{
  // VirtualBox CLI. Default install location shown; override if yours differs.
  "VBoxManagePath": "C:\\Program Files\\Oracle\\VirtualBox\\VBoxManage.exe",

  // Folder for the downloaded image, base.vdi and the generated per-node seed ISOs.
  "WorkingDir": "C:\\ft_test_env",

  "Image": {
    // Debian 13 "generic" cloud image (broader drivers than "genericcloud" under VirtualBox).
    // Pinned to a dated snapshot for reproducibility; bump the folder/filename/Sha512 together
    // to update (checksums live in the SHA512SUMS file beside the image). "latest" also exists
    // but rolls forward, which would break the checksum.
    "Url": "https://cloud.debian.org/images/cloud/trixie/20260601-2496/debian-13-generic-amd64-20260601-2496.qcow2",
    "Sha512": "97675b27e69153002c4e13644e36200c8f9067f661dca00918c54f1cacbdb88d4bff8c0fbf5cf5d63a0397bdf0cc472d7a6372bae5281bf7ced756249c10f8a2",
    "FileName": "debian-13-generic-amd64-20260601-2496.qcow2"
  },

  "Network": {
    // The host NIC to bridge onto. Re-discover via: VBoxManage list bridgedifs (the "Name:" value).
    // Was the I218-V port; that link went down (cable unplugged), so the lab moved to the host's live
    // I211 NIC (same 192.168.0.0/24 LAN as .31/.1). Swap back if the I218-V link is restored.
    "BridgeAdapter": "Intel(R) I211 Gigabit Network Connection",
    "Gateway": "192.168.0.1",
    "Dns": "8.8.8.8",
    "PrefixLength": 24
  },

  "Linux": {
    "Username": "user",
    "Password": "live",
    // nfs-mountd is checked separately from nfs-server: nfs-server is a oneshot unit that still
    // reports 'active' when nfs-mountd has died underneath it (e.g. via systemd's start limit).
    "Services": [ "ssh", "nfs-server", "nfs-mountd", "smbd", "vsftpd", "tinyproxy", "diod", "nginx", "ft-s3" ],
    "ExpectedMounts": [
      "/media/smb/192.168.0.31/e",
      "/media/smb/192.168.0.31/r",
      "/media/smb/192.168.0.81/data",
      "/media/nfs/192.168.0.81/tmpfs",
      "/media/smb/192.168.0.84/shared",
      "/media/vboxsf/192.168.0.31/c_drive",
      "/media/9p/192.168.0.81/export"
    ],
    "SshPort": 22,
    "SshReadyTimeoutSeconds": 180
  },

  "Nodes": [
    { "Name": "ft-node-81", "Hostname": "ft-node-81", "Ip": "192.168.0.81", "IsServer": true },
    { "Name": "ft-node-80", "Hostname": "ft-node-80", "Ip": "192.168.0.80", "IsServer": false },
    { "Name": "ft-node-82", "Hostname": "ft-node-82", "Ip": "192.168.0.82", "IsServer": false, "QemuHost": true }
  ],

  // The dedicated Windows nodes are LINKED CLONES of a hand-built gold VM (see FT_WIN_GOLD_IMAGE.md),
  // reconfigured to their own IP/hostname over SSH each bring-up (rclone_tester's technique). The gold is
  // derived once from rclone-win-gold; SourceIp .90 is where every fresh clone boots before reconfiguration.
  // Password lives in user-secrets: dotnet user-secrets set "WindowsGold:Password" "<pass>".
  "WindowsGold": {
    "Enabled": true,
    "GoldVmName": "ft-win-gold",
    "GoldSnapshot": "clean",
    "SourceIp": "192.168.0.92",
    "Username": "smith",
    "Password": "",
    "SshPort": 22,
    "SshReadyTimeoutSeconds": 240,
    "ReconfigTimeoutSeconds": 300,
    "ShutdownTimeoutSeconds": 60,
    "MemoryMb": 4096,
    "Cpus": 2,
    "FtExeSource": "R:\\Temp\\ft release\\win-x64\\ft.exe",
    "RunRemoteSource": "C:\\Users\\Smith\\Desktop\\dev\\cs\\RunRemote\\server\\bin\\Release\\net8.0-windows\\win-x64\\publish",
    "SharedSharePath": "C:\\Temp\\ft\\Shared"
  },

  // The two orchestrator-managed Windows CLIENT VMs (linked clones off ft-win-gold). client1=.83, client2=.85.
  // The Windows SMB/RDP SERVER is a SEPARATE hand-built VM (.84) with a DISTINCT machine SID — NOT listed here
  // because it isn't cloned/managed by this tool: cloned VMs share the gold's SID, and Windows 24H2+ rejects
  // SMB/RDP auth between same-SID peers, so the server had to be a fresh install. ft_tests reaches .84 directly
  // by IP. Reboot either client VM (menu 8) to clear tiring; the linked-clone diff is persistent, so config survives.
  "WindowsNodes": [
    { "CloneName": "ft-win-client1", "Ip": "192.168.0.83", "Hostname": "ft-win-client1", "Role": "Client1" },
    { "CloneName": "ft-win-client2", "Ip": "192.168.0.85", "Hostname": "ft-win-client2", "Role": "Client2" }
  ],

  // The hand-built Windows SMB/RDP SERVER VM (.84) — a fresh install with a DISTINCT machine SID (NOT a clone;
  // a same-SID clone can't serve SMB/RDP to another clone). This tool only starts / health-checks / reboots it;
  // it is built + provisioned by hand once (see FT_WIN_GOLD_IMAGE.md "Server VM"). Uses the gold's smith account.
  "WindowsServer": {
    "Enabled": true,
    "VmName": "ft-win-server",
    "Ip": "192.168.0.84",
    "SharedSharePath": "C:\\Temp\\ft\\Shared"
  },

  // The dev box (.31) is no longer a tunnel endpoint, but still hosts the VBox shared folder (c_drive ->
  // host C:\) that VirtualBoxSharedFolder rows read via \\vboxsvr, and serves as the SOCKS destination.
  "WindowsHosts": [
    {
      "Name": "dev-box",
      "Host": "192.168.0.31",
      "CredentialKey": null,
      "Checks": [
        { "Type": "NetShare", "Target": "e", "Description": "E drive share" },
        { "Type": "NetShare", "Target": "r", "Description": "R drive share" },
        { "Type": "PathExists", "Target": "C:\\Temp", "Description": "Temp folder" }
      ]
    }
  ],

  // Windows + SMB credentials live in user-secrets, NOT here. Set them with:
  //   dotnet user-secrets set "WindowsGold:Password" "<pass>"          // the shared account baked into ft-win-gold
  //   dotnet user-secrets set "Credentials:smb:Username" "<user>"      // fills mounts.sh for the //.31 + //.84 CIFS shares
  //   dotnet user-secrets set "Credentials:smb:Password" "<pass>"      // (use the same shared Windows account for //.84\Shared)
  "Credentials": {}
}
