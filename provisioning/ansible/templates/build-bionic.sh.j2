#!/bin/bash
# Written by the File Tunnel lab's playbook. Builds ft for Android/Termux (linux-bionic-arm64,
# NativeAOT) from the PC's working tree (/srv/ft-src, read-only) and writes the binary to the PC's
# output folder (/srv/ft-out). Run as vagrant: .\build-android.ps1 on the PC does that.
set -euo pipefail

export DOTNET_ROOT=/opt/ftbuild/dotnet
export NUGET_PACKAGES=/opt/ftbuild/nuget
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export PATH="$DOTNET_ROOT:/opt/ftbuild/android-ndk-{{ linux.build.ndk }}/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH"

work=/opt/ftbuild/work
# A local copy: building straight off the shared folder is slow, and the build writes obj/ and
# bin/. Those are kept between runs (rsync doesn't delete what it excludes), so a rebuild is quicker.
rsync -a --delete --exclude bin/ --exclude obj/ /srv/ft-src/ft/ "$work/ft/"
version=$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' "$work/ft/ft.csproj" | head -n 1)
echo "Building ft ${version:-?} for linux-bionic-arm64 (NativeAOT) from the PC's working tree"

rm -rf "$work/out"
dotnet publish "$work/ft/ft.csproj" -r linux-bionic-arm64 -c Release \
  -p:PublishAot=true -p:DisableUnsupportedError=true -p:PublishAotUsingRuntimePack=true \
  -o "$work/out"

file "$work/out/ft"
cp -f "$work/out/ft" /srv/ft-out/ft   # a VirtualBox shared folder: no Unix modes to set
echo "Built: ft ${version:-?} for Android, in the PC's {{ linux.build.output_dir }}"
