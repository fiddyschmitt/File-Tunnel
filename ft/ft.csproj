<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<OutputType>Exe</OutputType>
	<!-- Single source of truth for the product version: the SDK turns <Version> into the
	     Assembly/File/Informational version attributes, and Program.cs reads it back at runtime
	     (see VERSION). IncludeSourceRevision=false keeps InformationalVersion exactly the <Version>. -->
	<Version>3.5.3</Version>
	<Product>File Tunnel</Product>
	<Copyright>Copyright © 2023</Copyright>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<!-- .NET 9+ marks the Windows host CET-compatible (shadow stacks), which fast-fails at launch on
	     Windows builds that lack the CET servicing fix (dotnet/runtime#110920) - exactly the locked-down,
	     un-updated machines ft is most used on (issue #39). ft gains little from shadow-stack hardening,
	     so trade it for the ability to start everywhere, matching the net8.0-era releases. -->
	<!--<CetCompat>false</CetCompat>-->
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
	<PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="CommandLineParser" Version="2.9.1" />
	<PackageReference Include="FluentFTP" Version="54.2.0" />
	<PackageReference Include="System.IO.Hashing" Version="10.0.11" />
	<PackageReference Include="System.Threading.RateLimiting" Version="10.0.11" />
  </ItemGroup>

  <!-- NativeAOT for Android/Termux (linux-bionic-arm64, issue #45): work around a known linker
       version-script error (see dotnet/runtime android-bionic docs). No effect on other RIDs -
       the condition is false for them. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <LinkerArg Include="-Wl,--undefined-version" />
  </ItemGroup>
</Project>